# ─── Server ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Number of reverse-proxy hops to trust for X-Forwarded-For (e.g. 1 behind a
# single load balancer / Nginx / Render / Fly.io edge). Leave at 0 for local
# development or when running with no proxy in front of the app. Getting
# this wrong under-trusts (client IPs look wrong, rate limiting misbehaves)
# or over-trusts (a client can spoof its own IP) — see express-rate-limit's
# docs on `trust proxy` before changing it.
TRUST_PROXY_HOPS=0

# ─── AI API Keys (at least one is required) ─────────────────────────────────
NVIDIA_API_KEY=your_nvidia_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ─── AI Model Selection (optional) ───────────────────────────────────────────
# The exact model ID sent to each provider's API. Override these when a
# provider deprecates or renames a model — no code change/deploy needed.
# Example: Groq deprecated llama-3.3-70b-versatile for free/developer-tier
# keys on 2026-08-16; run `node scripts/test-provider-keys.mjs` any time to
# check whether your current keys/models are actually working.
#
# Current Groq alternatives (check https://console.groq.com/docs/models for
# the latest): openai/gpt-oss-120b (default here), openai/gpt-oss-20b
# (faster/cheaper), qwen/qwen3.6-27b.
GROQ_MODEL=openai/gpt-oss-120b

# Ceiling sent as max_completion_tokens on every Groq call. Groq's
# free/on-demand tier enforces a hard tokens-per-minute cap per model (as
# low as 8000 TPM for some models/orgs) and checks it BEFORE generating a
# response — so it's counting this reserved ceiling, not actual output
# size. If this is set at or above your tier's TPM cap, EVERY Groq request
# will 413 with "Request too large... Requested <N>", regardless of prompt
# size. 4096 is a safe default that still comfortably covers this app's
# largest real response (a 15-question JSON array, or a multi-section
# markdown evaluation). Raise it if your Groq tier has more TPM headroom.
GROQ_MAX_COMPLETION_TOKENS=4096

# NVIDIA NIM model id.
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Model used ONLY when Gemini is picked automatically as the fallback for a
# failed Groq/NVIDIA call — not the primary Gemini model (that's whichever
# gemini-* option the user selects in the app).
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# ─── App Configuration ───────────────────────────────────────────────────────
QUESTIONS_PER_INTERVIEW=10
JD_QUESTIONS_PER_INTERVIEW=15
SILENCE_TIMEOUT_MS=15000

# ─── Speech-to-Text (optional) ───────────────────────────────────────────────
# Server-side ASR pass on the candidate's recorded answer audio, run
# ALONGSIDE the browser's own Web Speech API to improve the transcript
# before it's submitted — see
# docs/project-improvement/VOICE_RECOGNITION_ACCURACY_PLAN.md. Fully
# additive: uses the SAME GROQ_API_KEY / GEMINI_API_KEY already configured
# above, no new credential required. Set STT_ENABLED=false to fall back to
# exactly today's behavior (Web Speech text only, no new network call).
STT_ENABLED=true

# Ordered provider preference, comma-separated. Only entries with a
# configured key are actually tried, in this order; if every configured
# provider fails (or STT_ENABLED=false), the app silently keeps the Web
# Speech transcript — this is never a hard failure for the candidate.
STT_PROVIDER_CHAIN=groq,gemini

# whisper-large-v3-turbo: free on Groq's free tier as of this feature's
# plan doc (verify current limits at
# https://console.groq.com/docs/speech-to-text before relying on it at
# scale) — 216x real-time, and accepts a vocabulary-biasing prompt (see
# STT_KEYWORD_BIAS below). Override if Groq renames/deprecates it, same
# reasoning as GROQ_MODEL above.
STT_GROQ_MODEL=whisper-large-v3-turbo

STT_LANGUAGE=en
STT_MAX_AUDIO_MB=10
STT_MAX_AUDIO_SECONDS=600
STT_TIMEOUT_MS=15000

# Feeds each question's own topic + expectedKeywords to the ASR model as a
# vocabulary hint (Groq's `prompt` param / a Gemini instruction) — this is
# the single biggest accuracy lever for this app specifically, since those
# keywords are exactly the technical terms most often mis-heard (e.g.
# `uv_queue_work`, `AsyncLocalStorage`, `highWaterMark`).
STT_KEYWORD_BIAS=true

# NOTE: END_SESSION_EVAL_WAIT_MS previously bounded how long "End Interview"
# would wait for still-in-flight per-question evaluations before finalizing
# with an "unavailable" placeholder. It's been removed — endSession now
# waits for real completion instead of a fixed clock, so a placeholder only
# ever appears when every configured AI provider has genuinely been tried
# and failed for that question (each attempt already capped by its own
# ~120s request timeout — see src/services/ai/baseService.ts's
# createTimeoutSignal). See src/services/interview.service.ts's endSession.

# ─── Security ────────────────────────────────────────────────────────────────
# Used to derive the AES-256-GCM key that encrypts saved user API keys at
# rest. Must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_SECRET=generate_a_32_byte_hex_string_here

# Used to sign session JWTs. Must be at least 32 characters, and MUST be a
# different value from ENCRYPTION_SECRET. Generate the same way as above.
JWT_SECRET=generate_a_different_32_byte_hex_string_here

# How long a login session stays valid, in seconds. Default: 7 days.
JWT_TTL_SECONDS=604800

# Whether the auth cookie is marked `Secure` (HTTPS-only). Defaults to true
# automatically when NODE_ENV=production; set explicitly to override, e.g.
# to false when testing a production build over plain HTTP locally.
# COOKIE_SECURE=true

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins, e.g.:
#   ALLOWED_ORIGINS=https://app.example.com,https://www.example.com
# REQUIRED in production — the app refuses to start with a wildcard CORS
# origin when NODE_ENV=production. Defaults to "*" in development only.
# ALLOWED_ORIGINS=

# ─── Database (PostgreSQL — e.g. Supabase, Neon, RDS, or self-hosted) ────────
# Running the bundled docker-compose.yml (its own local Postgres, not one
# of the managed providers below)? It also requires POSTGRES_PASSWORD —
# compose refuses to start without it, on purpose; see that file's db
# service. DATABASE_URL/DIRECT_URL below are for every OTHER setup.
# POSTGRES_PASSWORD=generate_a_real_password_here

# Pooled connection, used by the app at runtime.
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct (non-pooled) connection, used only for running migrations.
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres"

# Required in production (the app refuses to start without it when
# NODE_ENV=production). Optional in development — the app falls back to a
# bounded in-memory store when the database is unreachable, but that store
# does not survive a restart and is not shared across instances.
