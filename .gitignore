# ─── Environment & Secrets ────────────────────────────────────────────────────
# NEVER commit real credentials
.env
.env.local
.env.*.local
.env.production
.env.staging

# ─── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
.npm/

# ─── TypeScript Build Output ──────────────────────────────────────────────────
dist/
build/
*.js.map
*.d.ts.map

# ─── Prisma Generated Client ──────────────────────────────────────────────────
